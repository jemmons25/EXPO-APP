# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CardDrop

# Auth — secret used to sign session + magic-link JWTs
AUTH_SECRET=change-me-to-a-long-random-string

# Database (SQLite for dev; use postgresql://... in production)
DATABASE_URL="file:./dev.db"

# Email (magic links). Leave empty in dev — links are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CardDrop <hello@carddrop.app>"

# Google OAuth (optional — button hides itself if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Wallet (all required for real signed .pkpass files)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.carddrop.businesscard
APPLE_CERT_PEM_BASE64=
APPLE_CERT_KEY_PEM_BASE64=
APPLE_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# Google Wallet (all required for real Save-to-Wallet links)
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_PAY_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=carddrop_business_card
